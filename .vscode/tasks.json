{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure (Debug)",
            "type": "shell",
            "command": "cmake --preset Debug",
            "problemMatcher": []
        },
        {
            "label": "Build (Debug)",
            "type": "shell",
            "command": "cmake --build --preset Debug",
            "dependsOn": "Configure (Debug)",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Configure (Release)",
            "type": "shell",
            "command": "cmake --preset Release",
            "problemMatcher": []
        },
        {
            "label": "Build (Release)",
            "type": "shell",
            "command": "cmake --build --preset Release",
            "dependsOn": "Configure (Release)",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Flash (ST-Link SWD)",
            "type": "shell",
            "command": "STM32_Programmer_CLI -c port=SWD mode=UR -w build/Debug/h562_app.elf -v -rst",
            "linux": {
                "command": "${userHome}/.local/openocd-st/bin/openocd -s ${userHome}/.local/openocd-st/share/openocd/scripts -f interface/stlink-dap.cfg -f tools/openocd-h5.cfg -c \"program build/Debug/h562_app.elf verify reset exit\""
            },
            "dependsOn": "Build (Debug)",
            "problemMatcher": []
        },
        {
            "label": "Flash (USB DFU)",
            "detail": "Giữ BOOT0, cắm/reset board trước khi chạy",
            "type": "shell",
            "command": "STM32_Programmer_CLI -c port=usb1 -w build/Debug/h562_app.hex -v -rst",
            "dependsOn": "Build (Debug)",
            "problemMatcher": []
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "cmake --build --preset Debug --target clean",
            "problemMatcher": []
        }
    ]
}